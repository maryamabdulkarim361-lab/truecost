rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same owner/editor/viewer policy as Firestore projects. Server reports are
    // written with Admin SDK; no browser may create or overwrite a report.
    function member(projectId, editing) {
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      return request.auth != null && (project.ownerId == request.auth.uid
        || (project.get('collaborators', []) is list
          && (project.get('collaborators', []).hasAny([{'userId': request.auth.uid, 'role': 'editor'}])
            || (!editing && project.get('collaborators', []).hasAny([{'userId': request.auth.uid, 'role': 'viewer'}])))));
    }
    // Current FileUpload stores under the verified user's uid. The old optional
    // canvasId overload has no established ownership model and fails closed.
    match /construction-plans/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /projects/{projectId}/plans/{allPaths=**} {
      allow read: if request.auth != null && member(projectId, false);
      allow write: if request.auth != null && member(projectId, true);
    }
    // PDFs use authenticated backend-issued signed links, never client writes.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
